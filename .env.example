# Hero Echoes online service (game client)
# Copy to .env (gitignored) and edit:
#   cp .env.example .env
#
# At build time Gradle bakes ECHO_API_KEY into every platform:
#   Android → BuildConfig.ECHO_API_KEY
#   desktop / iOS → gitignored src/generated/.../EchoBuildConfig.java

# Backend URL for local/debug. Localhost → 10.0.2.2 on Android emulator.
# Packaged desktop/iOS fall back to project-links.properties backend.url.
ECHO_BACKEND_URL=http://localhost:3000

# One API key for all platforms and build types (debug + release).
ECHO_API_KEY=change-me-to-match-backend-echo-api-key

# Optional Android release URL override — if unset, release uses backend.url
# from services/src/main/resources/project-links.properties (then ECHO_BACKEND_URL).

# Sentry (Android). Create an Android project in org dungeonboss and paste its DSN.
# Desktop: desktop/src/main/resources/sentry.properties (project "java").
# iOS: ios/src/main/resources/sentry.properties (project "ios").
# Source context (+ Android ProGuard maps) — REQUIRED for every release build.
# prepareRelease / assembleRelease / desktop:release / createIPA / release.ps1 all need this.
# Set in the environment or here (never commit a real token):
#   https://sentry.io/settings/dungeonboss/auth-tokens/
# GitHub Actions: repository secret SENTRY_AUTH_TOKEN (required by ios-unsigned).
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
SENTRY_ORG=dungeonboss
SENTRY_PROJECT=android
